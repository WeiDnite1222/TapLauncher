/* Add your QSS styles here */

QLabel#dev_info_box {
    font-size: 20pt;
    font-weight: bold;
}

QLabel#dev_info_message {
    font-size: 10pt;
}

QLabel#version_label, QLabel#version_label {
    font-weight: bold;
}

QLabel#icon_label {
    border-radius: 20px;
}