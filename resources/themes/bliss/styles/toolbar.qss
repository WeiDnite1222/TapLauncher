QToolBar {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #5794f5,stop:0.1 #2879ed,stop:0.85 #245edb,stop:1 #1545ae);
    border: 1px solid #0041b5;
    spacing: 4px;
    padding: 3px;
}
QToolBar QToolButton, QToolBar QPushButton {
    color: #ffffff;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #5596f9,stop:1 #215bc6);
    border: 1px solid #1752b8;
    border-radius: 4px;
    padding: 6px;
    font-size: 13px;
}
QToolBar QToolButton:hover, QToolBar QPushButton:hover { border-color: #99c2ff; background: #408cf1; }
QToolBar QToolButton:focus, QToolBar QToolButton:checked, QToolBar QPushButton:focus, QToolBar QPushButton:checked {
    background: #174cac;
    border-color: #b6d4ff;
}
QToolBar QToolButton:pressed, QToolBar QPushButton:pressed { background: #123c91; }
QToolBar QToolButton:disabled, QToolBar QPushButton:disabled { color: #8590a0; }
QToolBar::separator { background: #b0bac8; width: 1px; height: 1px; margin: 4px; }
QToolBar::handle { background: #d1d8e3; border: 1px solid #b0bac8; width: 4px; height: 4px; border-radius: 2px; }
