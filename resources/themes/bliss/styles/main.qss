QWidget {
    font-family: "Tahoma", "Segoe UI";
    font-size: 13px;
}
QMainWindow, QDialog {
    color: #000000;
    background: #ece9d8;
}
QPushButton, QToolButton {
    color: #000000;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff, stop:0.45 #f5f3e9, stop:0.5 #e0ddce, stop:1 #faf9f3);
    border: 1px solid #003c74;
    border-radius: 3px;
    padding: 4px 14px;
    min-height: 22px;
}
QPushButton:hover, QToolButton:hover { border-color: #e59700; }
QPushButton:default, QPushButton:checked, QToolButton:checked {
    color: #003399;
    border-color: #3266ac;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #e9f8ff, stop:0.45 #a7d0ff, stop:0.5 #649be5, stop:1 #c2e2ff);
}
QPushButton:pressed, QToolButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #79a5db, stop:0.5 #4f86ca, stop:1 #a2c9f4);
}
QPushButton:disabled, QToolButton:disabled { color: #8590a0; border-color: #b9c1cc; }
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox,
QComboBox, QListView, QTreeView, QTableView {
    background: #ffffff;
    color: #000000;
    border: 1px solid #7f9db9;
    border-top-color: #6e7c90;
    border-radius: 4px;
    padding: 4px;
    selection-background-color: #316ac5;
    selection-color: #ffffff;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color: #e59700; }
QComboBox { padding-right: 26px; }
QComboBox::drop-down {
    width: 20px;
    border-left: 1px solid #7d9abd;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #e4f5ff, stop:0.48 #a1caff, stop:0.5 #699ee3, stop:1 #b9ddff);
}
QComboBox QAbstractItemView { background: #ffffff; color: #000000; selection-background-color: #316ac5; selection-color: #ffffff; }
QGroupBox { border: 1px solid #aab2bf; border-radius: 7px; margin-top: 10px; padding-top: 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; }
QProgressBar { border: 1px solid #8a9ab0; border-radius: 7px; background: #e0e5ed; color: #000000; text-align: center; min-height: 14px; }
QProgressBar::chunk {
    border-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #e5f6ff, stop:0.4 #8ac4ff, stop:0.5 #4589db, stop:1 #9bd0ff);
}
QTabWidget::pane { border: 1px solid #9aa9bc; border-radius: 6px; }
QTabBar::tab { border: 1px solid #9aa9bc; padding: 5px 14px; background: #e4e9f0; }
QTabBar::tab:selected { background: #a8ceff; color: #16355f; }
QScrollBar { background: #e7eaf0; border: 1px solid #b3bdcc; }
QScrollBar:vertical { width: 16px; }
QScrollBar:horizontal { height: 16px; }
QScrollBar::handle { border: 1px solid #6e9bc9; border-radius: 6px; background: #a4cff7; }
QScrollBar::handle:vertical { min-height: 24px; background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #dff4ff,stop:0.5 #83b9ef,stop:1 #c7e7ff); }
QScrollBar::handle:horizontal { min-width: 24px; background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #dff4ff,stop:0.5 #83b9ef,stop:1 #c7e7ff); }
QLabel#dev_info_box { font-size: 20pt; font-weight: bold; }
QLabel#dev_info_message { font-size: 10pt; }
QLabel#version_label { font-weight: bold; }

QMessageBox { background: #ece9d8; }
QMessageBox QLabel { color: #003399; background: transparent; }
QMessageBox QPushButton { min-width: 72px; }
QMessageBox QPushButton:default {
    border-color: #3266ac;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #e9f8ff,stop:0.45 #a7d0ff,stop:0.5 #649be5,stop:1 #c2e2ff);
}
QMessageBox QPushButton:pressed { background: #79a5db; }

/* Luna-style panels, warm button faces and segmented green progress. */
QPushButton, QToolButton {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #ffffff,stop:0.8 #f0eddf,stop:1 #d8d2bd);
}
QPushButton:hover, QToolButton:hover { border-color: #e59700; }
QPushButton:default { border-color: #316ac5; }
QPushButton:pressed, QToolButton:pressed { background: #c9d9ef; }
QPushButton:disabled, QToolButton:disabled { background: #ece9d8; color: #868478; }
QProgressBar { background: #ffffff; border-color: #7f9db9; border-radius: 3px; }
QProgressBar::chunk {
    width: 10px;
    margin: 1px;
    border-radius: 1px;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #b7ee8b,stop:0.5 #54b42b,stop:1 #2c931a);
}
QTabBar::tab:selected { border-top: 3px solid #e9a32b; background: #fcfcfe; }
