QFrame#profileButton {
    border: 1px solid #7f9db9;
    border-radius: 3px;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffffff,stop:0.48 #ebf3ff,stop:0.5 #d6e5fa,stop:1 #f7fbff);
}
QFrame#profileButton:hover { border-color: #e59700; }
QLabel#profileName, QLabel#itemName { color: #003399; font-size: 15px; font-weight: bold; }
QLabel#profileVersion, QLabel#itemVersion { color: #555d69; font-size: 12px; }
QLabel#profileArrow { background: transparent; color: #34649c; font-size: 18px; }
QLabel#launchStatus { font-size: 12px; font-weight: bold; }
QFrame#profilePopup { border: 1px solid #7f9db9; border-radius: 8px; background: #f7faff; }
QWidget#profileListContent { background: #ffffff; }
QPushButton#profileItem {
    /* Content height + two 1px borders = 62px; the layout supplies padding. */
    min-height: 60px;
    padding: 0;
    background: #ffffff;
    border: 1px solid transparent;
    border-radius: 5px;
    text-align: left;
}
QPushButton#profileItem:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #5286d4,stop:1 #316ac5);
}
QPushButton#profileItem QLabel[itemHovered="true"] { color: #ffffff; background: transparent; }
QPushButton#launchButton, QPushButton#logButton {
    font-size: 15px;
    font-weight: bold;
    color: #ffffff;
    border: 1px solid #25621b;
    border-radius: 8px;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #93d875,stop:0.15 #55ad39,stop:0.8 #31851e,stop:1 #246514);
}
QPushButton#launchButton:hover, QPushButton#logButton:hover { border-color: #e59700; background: #4b9f2c; }
QPushButton#launchButton:pressed, QPushButton#logButton:pressed { background: #28691b; }
QPushButton#launchButton:disabled, QPushButton#logButton:disabled { color: #d9e3d5; background: #7b9472; }
QFrame#profileFrame { background: #dceaff; border: 1px solid #8fa8c9; border-radius: 3px; }
QFrame#header {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #5794f5,stop:0.18 #2879ed,stop:1 #0053cf);
    border: 1px solid #1654bd;
    border-radius: 5px;
}
QLabel#headerLabel { color: #ffffff; background: transparent; font-size: 20px; font-weight: bold; }

QPushButton#launchButton { min-width: 150px; }
QPushButton#logButton { min-width: 0; padding-left: 0; padding-right: 0; }
