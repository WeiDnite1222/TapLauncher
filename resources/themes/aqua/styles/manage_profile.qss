QLabel#manageTitle { color: #203653; font-size: 22px; font-weight: bold; padding: 4px; }
QScrollArea#manageProfileListScroll, QScrollArea#manageProfileOptionsScroll { background: #ffffff; border: 1px solid #9eafc5; border-radius: 8px; }
QPushButton#manageProfileItem {
    /* Content height + two 1px borders = 64px; the layout supplies padding. */
    min-height: 62px;
    padding: 0;
    background: #ffffff;
    color: #203653;
    border: 1px solid transparent;
    border-radius: 5px;
    text-align: left;
}
QPushButton#manageProfileItem:hover { background: #e2efff; }
QPushButton#manageProfileItem:checked { background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #80b8f4,stop:1 #3875d7); color: #ffffff; }
QPushButton#manageProfileItem QLabel[itemChecked="true"] { color: #ffffff; background: transparent; }
QLabel#itemName { color: #203653; font-size: 15px; font-weight: bold; }
QLabel#itemVersion { color: #626d7e; font-size: 12px; }
QFrame#profileEditor { background: transparent; }
QPushButton#saveProfileButton { min-width: 130px; font-weight: bold; }
QPushButton#dangerButton { color: #a52b38; }
