QFrame#profileButton {
    border: 1px solid #91a5c0;
    border-radius: 12px;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #ffffff,stop:0.48 #ebf3ff,stop:0.5 #d6e5fa,stop:1 #f7fbff);
}
QFrame#profileButton:hover { border-color: #4b8cde; }
QLabel#profileName, QLabel#itemName { color: #203653; font-size: 15px; font-weight: bold; }
QLabel#profileVersion, QLabel#itemVersion { color: #626d7e; font-size: 12px; }
QLabel#profileArrow { background: transparent; color: #34649c; font-size: 18px; }
QLabel#launchStatus { font-size: 12px; font-weight: bold; }
QFrame#profilePopup { border: 1px solid #91a5c0; border-radius: 8px; background: #f7faff; }
QWidget#profileListContent { background: #ffffff; }
QPushButton#profileItem {
    /* Content height + two 1px borders = 62px; the layout supplies padding. */
    min-height: 60px;
    padding: 0;
    background: #ffffff;
    border: 1px solid transparent;
    border-radius: 5px;
    text-align: left;
}
QPushButton#profileItem:hover {
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #80b8f4,stop:1 #3875d7);
}
QPushButton#profileItem QLabel[itemHovered="true"] { color: #ffffff; background: transparent; }
QPushButton#launchButton {
    min-width: 150px;
    font-size: 15px;
    font-weight: bold;
    border-radius: 16px;
    border-color: #3266ac;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #effaff,stop:0.45 #a7d0ff,stop:0.5 #649be5,stop:1 #c2e2ff);
}
QPushButton#launchButton:pressed { background: #79a5db; }
QFrame#profileFrame { background: #dceaff; border: 1px solid #8fa8c9; border-radius: 12px; }
QFrame#header { background: rgba(245, 250, 255, 220); border: 1px solid #b6c9e3; border-radius: 8px; }
QLabel#headerLabel { color: #203653; background: transparent; font-size: 20px; font-weight: bold; }
