QWidget {
    font-family: "Lucida Grande", "Lucida Sans Unicode", "Segoe UI";
    font-size: 13px;
}
QMainWindow, QDialog {
    color: #20252d;
    background: qlineargradient(spread:repeat, x1:0, y1:0, x2:0, y2:0.008,
        stop:0 #fafafa, stop:0.49 #fafafa, stop:0.5 #e9e9e9, stop:1 #e9e9e9);
}
QPushButton, QToolButton {
    color: #17263d;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #ffffff, stop:0.45 #edf2fa, stop:0.5 #ced9e9, stop:1 #f8fbff);
    border: 1px solid #8293ac;
    border-radius: 12px;
    padding: 4px 14px;
    min-height: 22px;
}
QPushButton:hover, QToolButton:hover { border-color: #4679ba; }
QPushButton:default, QPushButton:checked, QToolButton:checked {
    color: #102d57;
    border-color: #3266ac;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #e9f8ff, stop:0.45 #a7d0ff, stop:0.5 #649be5, stop:1 #c2e2ff);
}
QPushButton:pressed, QToolButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #79a5db, stop:0.5 #4f86ca, stop:1 #a2c9f4);
}
QPushButton:disabled, QToolButton:disabled { color: #8590a0; border-color: #b9c1cc; }
QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox,
QComboBox, QListView, QTreeView, QTableView {
    background: #ffffff;
    color: #20252d;
    border: 1px solid #919cac;
    border-top-color: #6e7c90;
    border-radius: 4px;
    padding: 4px;
    selection-background-color: #3875d7;
    selection-color: #ffffff;
}
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus,
QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus { border-color: #4b8cde; }
QComboBox { padding-right: 26px; }
QComboBox::drop-down {
    width: 20px;
    border-left: 1px solid #7d9abd;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #e4f5ff, stop:0.48 #a1caff, stop:0.5 #699ee3, stop:1 #b9ddff);
}
QComboBox QAbstractItemView { background: #ffffff; color: #20252d; selection-background-color: #3875d7; selection-color: #ffffff; }
QGroupBox { border: 1px solid #aab2bf; border-radius: 7px; margin-top: 10px; padding-top: 10px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 4px; }
QProgressBar { border: 1px solid #8a9ab0; border-radius: 7px; background: #e0e5ed; color: #17263d; text-align: center; min-height: 14px; }
QProgressBar::chunk {
    border-radius: 6px;
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
        stop:0 #e5f6ff, stop:0.4 #8ac4ff, stop:0.5 #4589db, stop:1 #9bd0ff);
}
QTabWidget::pane { border: 1px solid #9aa9bc; border-radius: 6px; }
QTabBar::tab { border: 1px solid #9aa9bc; padding: 5px 14px; background: #e4e9f0; }
QTabBar::tab:selected { background: #a8ceff; color: #16355f; }
QScrollBar { background: #e7eaf0; border: 1px solid #b3bdcc; }
QScrollBar:vertical { width: 16px; }
QScrollBar:horizontal { height: 16px; }
QScrollBar::handle { border: 1px solid #6e9bc9; border-radius: 6px; background: #a4cff7; }
QScrollBar::handle:vertical { min-height: 24px; background: qlineargradient(x1:0,y1:0,x2:1,y2:0,stop:0 #dff4ff,stop:0.5 #83b9ef,stop:1 #c7e7ff); }
QScrollBar::handle:horizontal { min-width: 24px; background: qlineargradient(x1:0,y1:0,x2:0,y2:1,stop:0 #dff4ff,stop:0.5 #83b9ef,stop:1 #c7e7ff); }
QLabel#dev_info_box { font-size: 20pt; font-weight: bold; }
QLabel#dev_info_message { font-size: 10pt; }
QLabel#version_label { font-weight: bold; }

QMessageBox { background: #f1f3f7; }
QMessageBox QLabel { color: #203653; background: transparent; }
QMessageBox QPushButton { min-width: 72px; }
QMessageBox QPushButton:default {
    border-color: #3266ac;
    background: qlineargradient(x1:0,y1:0,x2:0,y2:1,
        stop:0 #e9f8ff,stop:0.45 #a7d0ff,stop:0.5 #649be5,stop:1 #c2e2ff);
}
QMessageBox QPushButton:pressed { background: #79a5db; }
